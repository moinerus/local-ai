# Model weights and binaries. Never commit these.
*.gguf
*.bin
*.safetensors
*.onnx
models/
tts/
bin/*.exe
bin/*.dll

# Runtime output
logs/
*.log
bench/results/*.json
bench/results/*.csv

# A dated file is a baseline and is kept. Everything else in results/ is
# scratch from a run someone was iterating on. Without this the numbers a
# decision was made on live only on one machine, which is where they die.
!bench/results/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.json

# Secrets and local overrides
.env
.env.*
config/local.*
*.key

# Editor and OS
.vscode/
.idea/
Thumbs.db
desktop.ini
