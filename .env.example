# Copy to .env, or set these in your shell profile, before running the
# PowerShell launchers under serve/. Nothing else in the repo needs them: the
# benchmark harness and the recording proxy take an endpoint on the command
# line and never look at these.

# The llama-server binary built from llama.cpp.
LLAMA_EXE=C:\llama.cpp\llama-server.exe

# The directory holding the GGUF weight files. Each launcher appends the file
# name it wants, and names the full path it looked for if it is not there.
MODEL_DIR=C:\models

# Optional. A specific node binary for bench/node22.sh. Left unset, it finds a
# v22 under NVM_DIR, then falls back to a node on PATH that is v22 or newer.
# NODE22=/home/you/.nvm/versions/node/v22.20.0/bin/node
